# AMS-X environment template. Copy to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit it. Secrets (printer access codes) belong here
# or in `server/config/ams.local.yaml`, both of which are ignored.

# --- MQTT broker (Mosquitto on the CasaOS host) ---
AMSX_BUS_HOST=127.0.0.1
AMSX_BUS_PORT=1883

# --- Printer (LAN mode) — secrets, keep out of git ---
# Get the access code from the printer's network settings (LAN mode must be enabled).
AMSX_PRINTER_SERIAL=REPLACE_ME
AMSX_PRINTER_ACCESS_CODE=REPLACE_ME
AMSX_PRINTER_IP=192.168.1.50

# --- Spoolman (later) ---
# AMSX_SPOOLMAN_URL=http://127.0.0.1:7912
