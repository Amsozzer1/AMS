# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version.local

# uv
# (uv.lock IS committed; the cache is not)
.uv/

# Test / type / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ty_cache/
htmlcov/
.coverage
.coverage.*

# ---- PlatformIO / firmware ----
.pio/
.pioenvs/
.piolibdeps/

# ---- Secrets / local config (never commit real printer access codes / serials) ----
*.local.yaml
*.local.yml
*.secret.yaml
*.secret.yml
.env
.env.*
!.env.example
secrets/
.secrets/
# Keys / certs / credentials
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.credentials
*credentials*.json
.gitleaks-report.json

# ---- Editors / OS ----
.idea/
*.swp
.DS_Store

# ---- Local tool settings ----
# The Claude Code project config IS tracked (rules + subagents must travel between machines).
# Only the machine-local permission grants are ignored. NOTE: `.claude` itself must never be
# ignored — git cannot re-include a file whose parent directory is excluded.
.claude/settings.local.json

# ---- Media (large generated assets) ----
# docs/media holds large PNG/MP4 marketing assets; keep URLs in its README instead.
docs/media/*.mp4
docs/media/*.png
docs/media/*.jpg
docs/media/*.jpeg
!docs/media/README.md
# ---- Machine-local scratch & vendored third-party (never committed) ----
# tmp/      local .gcode.3mf test blobs
# spoolman/ vendored upstream clone; run it as a container instead (deploy/docker-compose.yml)
tmp/
spoolman/

# Generated API schema (regenerate with: uv run python server/scripts/dump_openapi.py)
server/openapi.json
