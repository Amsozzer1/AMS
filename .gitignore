# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version.local

# uv
# (uv.lock IS committed; the cache is not)
.uv/

# Test / type / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ty_cache/
htmlcov/
.coverage
.coverage.*

# ---- PlatformIO / firmware ----
.pio/
.pioenvs/
.piolibdeps/

# ---- Secrets / local config (never commit real printer access codes / serials) ----
*.local.yaml
*.local.yml
*.secret.yaml
*.secret.yml
.env
.env.*
!.env.example
secrets/
.secrets/
# Keys / certs / credentials
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.credentials
*credentials*.json
.gitleaks-report.json

# ---- Editors / OS ----
.idea/
*.swp
.DS_Store

# ---- Local tool settings ----
.claude/settings.local.json

# ---- Media (large generated assets) ----
# docs/media holds large PNG/MP4 marketing assets; keep URLs in its README instead.
docs/media/*.mp4
docs/media/*.png
docs/media/*.jpg
docs/media/*.jpeg
!docs/media/README.md
